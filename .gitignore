.DS_Store

design/
reports/
docs/rfc
docs/superpowers

# Local Claude Code config (shared .claude/settings.json stays tracked)
.claude/settings.local.json
.claude/worktrees/

# Machine-local faff config overlay (FAFF-387/FAFF-587 — gitignored; holds operator-private
# values such as the private tailnet ollama host. The committed base is .faffrc.yaml.)
# Glob covers every overlay variant (.yaml/.yml/.json, plus renamed/templated forms like
# .yaml.bak or .yaml.j2) so no operator-private overlay can slip past an exact-name entry.
.faffrc.local.*

# Faff run logs and local state
.faff/

# Generated eval reports (real-model run output — FAFF-130 onward)
eval/report/

# Local worktree scratch dir (not part of the project tree)
.worktrees/

# Local secrets / env (never commit — FAFF-315 leak fix)
.env
.env.*
!.env.example

# Claude box env
.env.claude-box
.gstack/
