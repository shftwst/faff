+#!/usr/bin/env bash
+# Integration smoke test for the walking skeleton (gk-20260819-wng8an).
+#
+# Brings the stack up, asserts GET /healthz returns 200 with the exact body
+# within 60s, checks the compose config has two services and a named volume,
+# then tears the stack down.
+set -euo pipefail
+
+cd "$(dirname "$0")/.."
+
+PORT="${API_PORT:-8080}"
+HEALTHZ="http://127.0.0.1:${PORT}/healthz"
+
+cleanup() {
+	docker compose down -v >/dev/null 2>&1 || true
+}
+trap cleanup EXIT
+
+echo "[smoke] bringing the stack up..."
+docker compose up -d --build
+
+echo "[smoke] polling ${HEALTHZ} for up to 60s..."
+deadline=$((SECONDS + 60))
+got=""
+while [ "$SECONDS" -lt "$deadline" ]; do
+	if body=$(curl -fsS "$HEALTHZ" 2>/dev/null); then
+		got="$body"
+		break
+	fi
+	sleep 1
+done
+
+if [ -z "$got" ]; then
+	echo "[smoke] FAIL: /healthz did not return 200 within 60s" >&2
+	docker compose ps >&2 || true
+	exit 1
+fi
+
+expected='{"status":"ok"}'
+if [ "$got" != "$expected" ]; then
+	echo "[smoke] FAIL: body was '$got', expected '$expected'" >&2
+	exit 1
+fi
+echo "[smoke] OK: /healthz -> 200 ${got}"
+
+echo "[smoke] checking compose topology (two services + named volume)..."
+config_file=$(mktemp)
+trap 'cleanup; rm -f "$config_file"' EXIT
+docker compose config --format json >"$config_file"
+python3 - "$config_file" <<'PY'
+import json, sys
+with open(sys.argv[1]) as fh:
+    cfg = json.load(fh)
+services = cfg.get("services", {})
+assert "api" in services and "datastore" in services, f"expected api+datastore, got {list(services)}"
+volumes = cfg.get("volumes", {})
+assert "pgdata" in volumes, f"expected a named volume 'pgdata', got {list(volumes)}"
+# datastore mounts the named volume at the data directory
+mounts = services["datastore"].get("volumes", [])
+data_mount = [m for m in mounts if m.get("target") == "/var/lib/postgresql/data"]
+assert data_mount, f"datastore has no mount at data dir: {mounts}"
+assert data_mount[0].get("source") == "pgdata", f"data dir not backed by named volume: {data_mount[0]}"
+assert data_mount[0].get("type") == "volume", f"data dir mount is not a named volume: {data_mount[0]}"
+print("[smoke] OK: two services (api, datastore) + named volume pgdata at data dir")
+PY
+
+echo "[smoke] PASS"
