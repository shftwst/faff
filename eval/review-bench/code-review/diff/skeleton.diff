diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
new file mode 100644
index 0000000..45d1e4c
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,20 @@
+name: ci
+
+on:
+  push:
+    branches: [main]
+  pull_request:
+
+jobs:
+  gates:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      # Container-based checks: no toolchain setup step, self-contained on any
+      # runner with Docker. The same commands run locally in faff's gate ladder.
+      - name: gofmt
+        run: '[ -z "$(docker run --rm -v "$PWD/api":/src -w /src golang:1.23 gofmt -l .)" ]'
+      - name: go vet
+        run: docker run --rm -v "$PWD/api":/src -w /src golang:1.23 go vet ./...
+      - name: go test
+        run: docker run --rm -v "$PWD/api":/src -w /src golang:1.23 go test ./...
