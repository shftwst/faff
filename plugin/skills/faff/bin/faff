// ===========================================================================
// === region:shell — subcommand registry + main dispatch ===
// ===========================================================================
// Subcommand registry (ADR 0014) — the single source of truth for the CLI command
// set. main() dispatches through this map, and `Object.keys(COMMANDS)` is exactly
// the canonical set `lint-cli-doc` asserts docs/guide/cli.md documents. Adding a
// subcommand = one entry here (and a docs/guide/cli.md row, or lint-cli-doc fails CI).
// The -h/--help/help aliases are handled in main() and are deliberately NOT entries.
// ===========================================================================
const COMMANDS = {
  "config": cmdConfig,
  "sync": cmdSync,
  "runcheck": cmdRuncheck,
  "heartbeat": cmdHeartbeat,
  "prepcheck": cmdPrepcheck,
  "intakecheck": cmdIntakecheck,
  "intake-record": cmdIntakeRecord,
  "contain": cmdContain,
  "self-intake": cmdSelfIntake,
  // FAFF-604: the dispatch shell is the sanctioned meeting point for the two
  // regions (it is exempt from the require-graph lint by design). `budget check`
  // is governance and may not require the factory, so the fleet-telemetry
  // resolver is handed to it here rather than reached for inside it.
  "budget": (args) => cmdBudget(args, { resolveUnmetered: unmeteredFleetEngines }),
  "economics": cmdEconomics,
  "disposition": cmdDisposition,
  "quality": cmdQuality,
  "reconcile": cmdReconcile,
  "run-done": cmdRunDone,
