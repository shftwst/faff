#!/usr/bin/env node
// faff — the bundled CLI for the faff skill suite.
//
// Single public entrypoint. Extensionless executable run directly via its shebang
// (`~/.claude/skills/faff/bin/faff <subcommand>`); `node …/bin/faff <subcommand>` also works.
// Plain CommonJS — no package.json, no dependencies, no install: one thin entrypoint (bin/faff) plus modules under bin/lib/.
//
// Per-subcommand reference: docs/guide/cli.md — the one CI-lint-enforced surface
// (`faff lint-cli-doc`, FAFF-237, asserts it covers every entry in COMMANDS below).
// `faff <sub> --help` / an unrecognised subcommand prints the compact USAGE synopsis
// (derived from COMMANDS, so it can't drift); this header intentionally does not
// re-enumerate commands — that duplication is what drifted before (FAFF-579).

// Module layout (FAFF-441): this entrypoint holds only the dispatch shell — USAGE, the
// COMMANDS registry, and main(). Every subcommand's implementation lives in a sibling
// module under bin/lib/, loaded on its first call (see `lazy` below). Modules resolve
// relative to this file (bin/lib/shared-infra.js owns the HERE / ENTRYPOINT path anchors),
// so both install shapes (symlink and CLAUDE_PLUGIN_ROOT copy) work unchanged.

// FAFF-1382: each subcommand module loads on first call, not at startup. Loading all of bin/lib
// costs about 230 ms per process against about 20 to 60 ms for the one module a subcommand needs,
// and the CLI is spawned on every hook call and hundreds of times per test file. `lazy` returns
// named stand-ins (the regions stale-null scan reads `COMMANDS[c].name`); the literal require()
// stays in the source so the require-graph lint sees the same edges.
function lazy(load, names) {
  const out = {};
  for (const name of names) {
    const fn = (...args) => load()[name](...args);
    Object.defineProperty(fn, "name", { value: name });
    out[name] = fn;
  }
  return out;
}

