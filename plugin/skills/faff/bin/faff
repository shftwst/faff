  "decisions": cmdDecisions,
  "andon": cmdAndon,
  "prd": cmdPrd,
  "prd-checklist": cmdPrdChecklist,
  "prdr": cmdPrdr,
  "profile": cmdProfile,
  "profiles": cmdProfiles,
  "fixtures": cmdFixtures,
  "env": cmdEnv,
  "eval": cmdEval,
  "engine": cmdEngine,
  "events": cmdEvents,
  "effects": cmdEffects,
  "review-progress": cmdReviewProgress,
  "build-progress": cmdBuildProgress,
  "sentry": cmdSentry,
  "sentry-poller": cmdSentryPoller,
