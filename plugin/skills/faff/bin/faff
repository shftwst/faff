  "labels": cmdLabels,
  "label": cmdLabel,
  "eligible": cmdEligible,
  "claim-verdict": cmdClaimVerdict,
  "admissible": cmdAdmissible,
  "dod": cmdDod,
  "holdout": cmdHoldout,
  "spec-review-lenses": cmdSpecReviewLenses,
  "container-check": cmdContainerCheck,
  "evaluator-preflight": cmdEvaluatorPreflight,
  "corrective-integrity": cmdCorrectiveIntegrity,
  "integrity-boundary": cmdIntegrityBoundary,
  "integrity-digest": cmdIntegrityDigest,
  "corrective": cmdCorrective,
  "merge-gate": cmdMergeGate,
  "branch-protection-check": cmdBranchProtectionCheck,
  "github-auth-check": cmdGithubAuthCheck,
  "ci-triage": cmdCiTriage,
  "post-merge-check": cmdPostMergeCheck,
  "governance-check": cmdGovernanceCheck,
  "harness": (args) => cmdHarness(args, COMMANDS),
  "next": cmdNext,
