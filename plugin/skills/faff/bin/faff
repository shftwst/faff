  "lint-cli-coverage": (args) => cmdLintCliCoverage(args, COMMANDS),
  "regions": (args) => cmdRegions(args, COMMANDS),
  "cli-surface": (args) => cmdCliSurface(args, COMMANDS),
  "models": cmdModels,
