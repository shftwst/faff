  "review-iteration-cap": cmdReviewIterationCap,
  "spec-review-churn": cmdSpecReviewChurn,
  "backends": cmdBackends,
};

// Compact synopsis — the command list is DERIVED from Object.keys(COMMANDS), so it
// cannot go stale the way a hand-enumerated header/USAGE could (FAFF-579). Full
// per-subcommand reference lives in docs/guide/cli.md, the one CI-lint-enforced
// surface (faff lint-cli-doc, FAFF-237); this stays a short pointer + name list.
const USAGE = `faff — the bundled CLI for the faff skill suite.

Usage: faff <subcommand> [args...]

Subcommands (full reference: docs/guide/cli.md):
${Object.keys(COMMANDS).sort().map((c) => `  ${c}`).join("\n")}

Run 'faff <subcommand> --help' where supported, or see docs/guide/cli.md for
per-subcommand flags and behavior.
`;

function main(argv) {
  const [sub, ...rest] = argv;
  if (!sub) { process.stderr.write(USAGE); return 2; }
  if (sub === "-h" || sub === "--help" || sub === "help") { process.stdout.write(USAGE); return 0; }
  const handler = COMMANDS[sub];
  if (handler) {
    // FAFF-362: a bad $FAFF_GOVERNANCE_PROFILE override (missing/malformed/shape-
    // invalid) is a GovernanceProfileError thrown by governance-profile.js's
    // activeProfile() — caught HERE, uniformly, for every subcommand (present or
    // future) that resolves the active governance profile, converting it to a
    // loud stderr line + exit 2. Never a silent fallback to the delivery profile.
    // Any other thrown error is a genuine bug — rethrown unchanged.
    try { return handler(rest); }
    catch (e) {
      if (e && e.faffGovernanceProfileError) { process.stderr.write(`faff: ${e.message}\n`); return 2; }
      // FAFF-577: a strict base-config failure surfacing from any subcommand that
      // did not handle it itself (governance entries, factory readers alike) is a
      // clean loud exit 2 — the chokepoint warning (file, detail, remedy, hatch)
      // already fired on stderr, so this line is just the command-level exit.
      if (e && e.message === "base-parse-error") {
        process.stderr.write(`faff ${sub}: cannot proceed — ${e.file} is malformed (${e.detail}).\n`);
        return 2;
      }
      // FAFF-627: readGovernanceConfig now rethrows "legacy-config-name" (was an
      // in-lib process.exit(2)) instead of exiting directly — the detailed
      // governance-flavoured message already fired on stderr from the lib before
      // this throw, mirroring the base-parse-error arm above; this is just the
      // command-level exit.
      if (e && e.message === "legacy-config-name") {
        const names = (e.legacy || []).join(", ");
        process.stderr.write(`faff ${sub}: cannot proceed — legacy config filename (${names}); rename to .faffrc.yaml.\n`);
        return 2;
      }
      throw e;
    }
  }
  process.stderr.write(`faff: unknown subcommand '${sub}'\n\n${USAGE}`);
  return 2;
}

// Run as a CLI only when invoked directly (shebang / `node …/bin/faff <sub>`), so a
// `require`/ESM `import` of this file for its exported pure functions (the FAFF-373
// corrective-integrity tests) does NOT execute a subcommand.
if (require.main === module) {
  // FAFF-580: faff's stated floor is POSIX (macOS/Linux) + Node >= 20 (ADR 0086) — native
  // Windows is a separate, future decision, not implied by anything here. Refuse a CLI
  // invocation on win32 with a clear message rather than letting it limp through with
  // mis-resolved paths. Deliberately inside this block, not at module top level: it must
  // fire only on an actual CLI invocation, never on a `require` of this file for its
  // exported pure functions (the FAFF-373 corrective-integrity tests import it on POSIX CI).
  if (process.platform === "win32") {
    process.stderr.write(
      "faff is POSIX-only (macOS/Linux). Native Windows is not supported — " +
      "run faff under WSL2. See the Requirements section in the README.\n"
    );
    process.exitCode = 1;
    return;
  }

  // FAFF-422: `engine call` is the first async handler (network one-shot) — a returned
  // Promise resolves to the exit code; every other handler stays a plain synchronous int.
  // The rejection arm is belt-and-braces: cmdEngine maps every internal error to an exit
  // code, so the promise resolves in practice — but an unforeseen reject (e.g. an EPIPE
  // from a broken stdout pipe) must still fail loud with a non-zero exit, never a silent 0.
  const r = main(process.argv.slice(2));
  if (r && typeof r.then === "function") {
    r.then((code) => { process.exitCode = code; },
           (e) => { process.stderr.write(`faff: unhandled error — ${(e && e.message) || e}\n`); process.exitCode = 2; });
  } else process.exitCode = r;
}

// Exported pure functions (FAFF-373). Extensionless CJS imported from ESM exposes
// only the default export, so tests destructure this object.
module.exports = {
  correctiveIntegrityProbe, integrityGate, correctiveIntegrityDirs,
  // FAFF-326: the corrective pure cores — exercised directly here (the asserted:true
  // "trusted" fold/validate path is unfakeable via a CLI child process, same reason
  // correctiveIntegrityProbe is exported above).
  CORRECTIVE_OPS, foldCorrectiveConstraints, validateCorrectiveInput,
  // FAFF-538: the COMMANDS registry keys are the single source of truth for the live
  // top-level verb set — exported so the scaffolder-cli-surface drift-guard imports the
  // verb list instead of re-listing it (require.main guard above keeps this import from
  // dispatching a subcommand).
  COMMANDS,
};
