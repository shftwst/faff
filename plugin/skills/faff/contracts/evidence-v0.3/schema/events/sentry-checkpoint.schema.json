          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "advisory_L3": {
          "type": "boolean"
        },
        "advisory": {
          "type": "string"
        },
        "signal": {
          "type": "string"
        },
        "member": {
          "type": "string"
        },
        "run_elapsed_secs": {
          "type": "integer"
        },
        "ceiling": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        },
        "tokens": {
          "type": [
            "object",
            "null"
          ],
          "description": "null is the estimate form (tokens_source estimate). The legacy cache_write class is accepted on committed lines; eventViolations normalises it before any new write.",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cache_read"
          ],
          "properties": {
            "input": {
              "type": "integer"
            },
            "output": {
              "type": "integer"
            },
            "cache_read": {
              "type": "integer"
            },
            "cache_write_5m": {
              "type": "integer"
            },
            "cache_write_1h": {
              "type": "integer"
            },
            "cache_write": {
              "type": "integer"
            }
          }
