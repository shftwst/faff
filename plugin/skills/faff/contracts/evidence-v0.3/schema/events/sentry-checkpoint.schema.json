  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "seq",
    "ts",
    "phase",
    "type",
    "prev"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "ts": {
      "type": "string"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "run",
        "tidy",
        "prep",
        "build",
        "plot"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "sentry-checkpoint"
      ]
    },
    "issue": {
      "type": "string"
    },
