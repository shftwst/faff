                        },
                        "heartbeat_age_secs": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "run_elapsed_secs": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        },
                        "tripped_on": {
                          "type": "string"
                        },
                        "in_flight": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "grace": {
                          "type": "string"
                        },
                        "ceiling_skip": {
                          "type": "string"
                        },
                        "source": {
                          "type": "string"
                        }
                      }
                    },
                    "heartbeat_age_secs": {
                      "type": "integer"
