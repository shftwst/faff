                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "last_progress_event_seq": {
                          "type": [
                            "integer",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "intervention": {
          "type": "string"
        },
        "tripped": {
          "type": "boolean"
