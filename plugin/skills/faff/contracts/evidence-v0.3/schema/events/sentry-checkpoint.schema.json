                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "member": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "event_seq": {
                          "type": [
                            "integer",
                            "null"
