                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "signal"
                  ],
                  "properties": {
                    "signal": {
                      "type": "string",
                      "enum": [
                        "heartbeat-progress-mismatch"
                      ]
                    },
                    "severity": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "member": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "object",
