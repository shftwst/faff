{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/evidence/v0.3/events/sentry-checkpoint",
  "title": "events.jsonl schema-2 record, type sentry-checkpoint",
  "description": "A completed sentry consult: the faff sentry check payload (sentry.js), relayed by the agent or written by sentry-poller.js. Older agent relays also carry signal, member and the ceiling fields.",
