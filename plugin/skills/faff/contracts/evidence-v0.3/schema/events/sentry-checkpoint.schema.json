            "required": [
              "signal"
            ],
            "discriminator": {
              "field": "signal",
              "mapping": {
                "budget-breach": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "signal"
                  ],
                  "properties": {
                    "signal": {
                      "type": "string",
                      "enum": [
                        "budget-breach"
                      ]
                    },
                    "severity": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "member": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "budget_outcome": {
                          "type": "string"
                        },
                        "breached": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
