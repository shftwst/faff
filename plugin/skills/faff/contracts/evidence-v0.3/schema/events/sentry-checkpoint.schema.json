                        "issue": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "recorded": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "recomputed": {
                          "type": "string"
                        },
                        "discovered_scope_filed": {
                          "type": "number"
                        },
                        "mandate": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "parent": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                },
                "budget-metering-degraded": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "signal"
                  ],
                  "properties": {
                    "signal": {
                      "type": "string",
                      "enum": [
                        "budget-metering-degraded"
                      ]
