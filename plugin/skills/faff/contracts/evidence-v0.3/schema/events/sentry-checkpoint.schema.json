                    },
                    "severity": {
                      "type": "string"
                    },
                    "scope": {
                      "type": "string"
                    },
                    "member": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "drift_kind": {
                          "type": "string"
