{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/contracts/prdr-admission",
  "title": "prdr-admission contract data",
  "description": "Reference schema (FAFF-255). The SHAPE of the PRDR two-gate-bound admission verdict that `faff prdr admit` PRODUCES and `faff contract prdr-admission` VALIDATES (consumer-side conformance, mirroring prd-readiness). NO safe coerce target — faff's own producer emits it, so an out-of-enum disposition or authority enum is a fail-loud, never coerced toward `admit`. The load-bearing invariant (an `admit` disposition implies the two-gate constraint — upper.admit ∧ by_level==ok ∧ ¬ratchet.breached ∧ lower.covered ∧ ¬(loop supersedes human)) is enforced in code as a conformance violation; it is not expressible in this shape schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["disposition", "upper", "lower", "authority", "ratchet", "reasons", "conformant", "violations"],
  "properties": {
    "disposition": { "type": "string", "enum": ["admit", "propose-only", "reject"] },
    "upper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admit", "reason"],
      "properties": {
        "admit": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "lower": {
      "type": "object",
      "additionalProperties": false,
      "required": ["covered", "uncovered_goals"],
      "properties": {
        "covered": { "type": "boolean" },
        "uncovered_goals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "supersedes_provenance", "by_level"],
      "properties": {
        "actor": { "type": "string", "enum": ["loop", "human"] },
        "supersedes_provenance": { "type": "string", "enum": ["human", "loop", "none"] },
        "by_level": { "type": "string", "enum": ["ok", "violation"] }
      }
    },
    "ratchet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineage_supersessions", "breached"],
      "properties": {
        "lineage_supersessions": { "type": "integer" },
        "breached": { "type": "boolean" }
      }
    },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "conformant": { "type": "boolean" },
    "violations": { "type": "array", "items": { "type": "string" } }
  }
}
