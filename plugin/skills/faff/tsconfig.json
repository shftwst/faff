{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useUnknownInCatchVariables": true,
    "erasableSyntaxOnly": true,
    "rewriteRelativeImportExtensions": true,
    "allowJs": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "types": [
      "node"
    ],
    "removeComments": false,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf"
  },
  "include": [
    "bin/lib/producer-auth.ts",
    "bin/lib/commissaire.ts",
    "bin/lib/commissaire-governor-client.ts",
    "bin/lib/commissaire-trust.ts",
    "bin/lib/commissaire-verify.ts",
    "bin/lib/ids.ts",
    "bin/lib/result.ts",
    "bin/lib/decision-policy.ts",
    "bin/lib/governor.ts",
    "bin/lib/governor-install.ts",
    "bin/lib/governor-admin.ts",
    "bin/lib/peer-cred.ts",
    "bin/lib/prep-attach.ts",
    "bin/lib/judge-dispositions.ts",
    "bin/lib/merge-authorize.ts",
    "bin/lib/graft-admit.ts",
    "bin/lib/gates-progress.ts",
    "bin/lib/land.ts",
    "bin/lib/spec-commit.ts",
    "bin/lib/run-summary.ts",
    "bin/lib/run.ts",
    "bin/lib/run-checkpoint.ts",
    "bin/lib/prose-size.ts"
  ]
}
