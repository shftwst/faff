#!/usr/bin/env python3
"""faffrc — resolve and read faff configuration from a .faffrc file.

The config file lives at the repo root in one of three forms (all YAML):

    .faffrc.yaml    .faffrc.yml    .faffrc

Exactly one may exist. If more than one is present at the repo root, that is an
error — faff stops and asks you to consolidate to a single file rather than
silently picking one. Template/example files are never counted or loaded: any
candidate whose name contains ".example" is ignored, so a committed
`.faffrc.example.yml` is documentation, not config.

Subcommands
-----------
  path                          Print the resolved config file path (empty + exit 3 if none).
  get <dotted.key> [-d DEF]     Print a scalar value at a dotted key (e.g. tracking.team_key).
                                Prints DEF (or empty) and exits 3 when the key is absent.
  spec-docs-path [--create]     Resolve tracking.spec_docs_path, applying the default rule
                                when unset; with --create, mkdir -p the resolved directory.
  dump                          Print the parsed config as JSON (debugging).

spec_docs_path default rule (when the key is unset), resolved against the repo root:
  1. docs/ exists  -> docs/specs
  2. doc/  exists  -> doc/specs
  3. neither       -> docs/specs   (the docs/ dir is created when --create is passed)
  (docs/ wins if both exist.)

YAML parsing uses PyYAML when it is importable; otherwise a built-in parser
handles the documented .faffrc subset: nested maps, scalars (quoted or bare),
booleans/ints/floats/null, block scalars (| and >), inline and full-line
comments. Block sequences (- item) are not supported by the fallback — install
PyYAML (`pip install pyyaml`) if a config needs them.
"""

import argparse
import json
import os
import re
import subprocess
import sys

CANDIDATES = (".faffrc.yaml", ".faffrc.yml", ".faffrc")


class MultipleConfigError(Exception):
    """More than one .faffrc form exists at the repo root."""


def repo_root():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=True,
        )
        root = out.stdout.strip()
        if root:
            return root
    except Exception:
        pass
    return os.getcwd()


def find_config(root):
    found = [
        os.path.join(root, name)
        for name in CANDIDATES
        if ".example" not in name and os.path.isfile(os.path.join(root, name))
    ]
    if len(found) > 1:
        raise MultipleConfigError(found)
    return found[0] if found else None


# ---------------------------------------------------------------------------
# YAML loading: PyYAML if available, else a built-in subset parser.
# ---------------------------------------------------------------------------

def load_yaml(text):
    try:
        import yaml  # type: ignore
        return yaml.safe_load(text) or {}
    except ImportError:
        return _minimal_parse(text)


def _strip_inline_comment(s):
    out, quote, i = [], None, 0
    while i < len(s):
        c = s[i]
        if quote:
            out.append(c)
            if c == quote:
                quote = None
        elif c in ('"', "'"):
            quote = c
            out.append(c)
        elif c == "#" and (i == 0 or s[i - 1] == " "):
            break
        else:
            out.append(c)
        i += 1
    return "".join(out).rstrip()


def _scalar(v):
    v = v.strip()
    if not v:
        return None
    if (v[0] == '"' and v[-1] == '"') or (v[0] == "'" and v[-1] == "'"):
        return v[1:-1]
    low = v.lower()
    if low in ("true", "false"):
        return low == "true"
    if low in ("null", "~"):
        return None
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    if re.fullmatch(r"-?\d*\.\d+", v):
        return float(v)
    return v


def _minimal_parse(text):
    raw = text.split("\n")
    n = len(raw)
    idx = [0]

    def is_skip(line):
        s = line.strip()
        return s == "" or s.startswith("#")

    def indent_of(line):
        return len(line) - len(line.lstrip(" "))

    def collect_block_scalar(parent_indent):
        lines, base = [], None
        while idx[0] < n:
            line = raw[idx[0]]
            if line.strip() == "":
                lines.append("")
                idx[0] += 1
                continue
            ind = indent_of(line)
            if ind <= parent_indent:
                break
            if base is None:
                base = ind
            lines.append(line[base:])
            idx[0] += 1
        while lines and lines[-1] == "":
            lines.pop()
        return ("\n".join(lines) + "\n") if lines else ""

    def parse_map(min_indent):
        result = {}
        while idx[0] < n:
            line = raw[idx[0]]
            if is_skip(line):
                idx[0] += 1
                continue
            ind = indent_of(line)
            if ind != min_indent:
                break
            content = _strip_inline_comment(line.strip())
            if content == "":
                idx[0] += 1
                continue
            key, _, val = content.partition(":")
            key, val = key.strip(), val.strip()
            idx[0] += 1
            if val in ("|", "|-", "|+", ">", ">-", ">+"):
                result[key] = collect_block_scalar(min_indent)
            elif val == "":
                j = idx[0]
                while j < n and is_skip(raw[j]):
                    j += 1
                if j < n and indent_of(raw[j]) > min_indent:
                    result[key] = parse_map(indent_of(raw[j]))
                else:
                    result[key] = None
            else:
                result[key] = _scalar(val)
        return result

    return parse_map(0)


# ---------------------------------------------------------------------------

def dig(data, dotted):
    cur = data
    for part in dotted.split("."):
        if isinstance(cur, dict) and part in cur:
            cur = cur[part]
        else:
            return None
    return cur


def fmt(value):
    if value is None:
        return ""
    if isinstance(value, bool):
        return "true" if value else "false"
    return str(value)


def load_config(root):
    path = find_config(root)
    if path is None:
        return {}, None
    with open(path, "r", encoding="utf-8") as fh:
        data = load_yaml(fh.read())
    return (data if isinstance(data, dict) else {}), path


def resolve_spec_docs_path(root, data, create):
    val = dig(data, "tracking.spec_docs_path")
    if val:
        rel = str(val).strip().rstrip("/")
    elif os.path.isdir(os.path.join(root, "docs")):
        rel = "docs/specs"
    elif os.path.isdir(os.path.join(root, "doc")):
        rel = "doc/specs"
    else:
        rel = "docs/specs"
    if create:
        os.makedirs(os.path.join(root, rel), exist_ok=True)
    return rel


def main(argv):
    parser = argparse.ArgumentParser(prog="faffrc", add_help=True, description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--root", default=None, help="repo root (default: git toplevel or cwd)")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("path", help="print the resolved .faffrc path")

    g = sub.add_parser("get", help="read a dotted key")
    g.add_argument("key")
    g.add_argument("-d", "--default", default=None)

    s = sub.add_parser("spec-docs-path", help="resolve tracking.spec_docs_path")
    s.add_argument("--create", action="store_true", help="mkdir -p the resolved directory")

    sub.add_parser("dump", help="print parsed config as JSON")

    args = parser.parse_args(argv)
    root = args.root or repo_root()

    try:
        if args.cmd == "path":
            path = find_config(root)
            if path is None:
                return 3
            print(path)
            return 0

        data, _ = load_config(root)

        if args.cmd == "get":
            value = dig(data, args.key)
            if value is None:
                if args.default is not None:
                    print(args.default)
                return 3
            print(fmt(value))
            return 0

        if args.cmd == "spec-docs-path":
            print(resolve_spec_docs_path(root, data, args.create))
            return 0

        if args.cmd == "dump":
            print(json.dumps(data, indent=2, default=str))
            return 0
    except MultipleConfigError as exc:
        names = ", ".join(os.path.basename(p) for p in exc.args[0])
        print(
            f"faffrc: multiple config files at the repo root ({names}); "
            f"keep only one.",
            file=sys.stderr,
        )
        return 2

    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
