#!/usr/bin/env python3
"""runcheck — mechanically verify a /faff-beep-boop run dispatched its queue.

The beep-boop "never silently defer the queue" guarantee is prose the agent is
asked to obey. This script makes it checkable: it reads the run ledger and
asserts that every issue admitted to the build queue reached a terminal
outcome. An admitted issue with no recorded outcome is an undispatched ("just
deferred to next run") issue — exactly the failure mode the contract forbids.

The ledger
----------
beep-boop maintains a machine-readable ledger per run at:

    .faff/runs/<run-id>/run-ledger.json

    {
      "run_id":  "2026-06-02-beep-boop-22-14-03",
      "admitted": ["SHF-1", "SHF-2", "SHF-3"],   // fire-and-forget + likely-fire
      "outcomes": { "SHF-1": "shipped", "SHF-2": "parked" }
    }

`admitted` is every issue the verdict gate admitted to the build queue.
`outcomes` maps an issue to its terminal state. The valid terminal states are
the run-summary buckets:

    shipped | pr-open | parked | errored | routed-out | unreached-budget

undispatched = admitted - outcomes.keys()

Subcommands
-----------
  (default) [RUN_DIR]   Audit a run (default: the most recent .faff/runs/*).
                        Prints a report. Exit 0 = clean, 3 = undispatched issues
                        remain, 2 = ledger missing / malformed.
  --json     [RUN_DIR]  Same audit, machine-readable JSON on stdout.
  --hook                Stop-hook mode: if the latest run has undispatched
                        admitted issues, print a Claude Code block decision
                        (JSON) and exit 0 so the hook blocks Stop with a reason;
                        otherwise stay silent and exit 0. Never errors out a
                        normal (non-beep-boop) session.

Exit codes (non-hook): 0 clean · 2 no/malformed ledger · 3 undispatched found.
"""
import json
import os
import sys

TERMINAL_STATES = {
    "shipped", "pr-open", "parked", "errored", "routed-out", "unreached-budget",
}


def repo_root(start=None):
    d = os.path.abspath(start or os.getcwd())
    while True:
        if os.path.isdir(os.path.join(d, ".faff")) or os.path.isdir(os.path.join(d, ".git")):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return os.path.abspath(start or os.getcwd())
        d = parent


def latest_run_dir(root):
    runs = os.path.join(root, ".faff", "runs")
    if not os.path.isdir(runs):
        return None
    candidates = [
        os.path.join(runs, name)
        for name in os.listdir(runs)
        if os.path.isdir(os.path.join(runs, name))
        and os.path.isfile(os.path.join(runs, name, "run-ledger.json"))
    ]
    if not candidates:
        return None
    # run-id names are date-prefixed (YYYY-MM-DD-...-HH-MM-SS) → lexical sort is chronological
    return sorted(candidates)[-1]


def load_ledger(run_dir):
    path = os.path.join(run_dir, "run-ledger.json")
    with open(path) as fh:
        data = json.load(fh)
    admitted = list(dict.fromkeys(data.get("admitted") or []))
    outcomes = data.get("outcomes") or {}
    if not isinstance(outcomes, dict):
        raise ValueError("outcomes must be an object")
    return data.get("run_id") or os.path.basename(run_dir), admitted, outcomes


def audit(run_dir):
    run_id, admitted, outcomes = load_ledger(run_dir)
    undispatched = [i for i in admitted if i not in outcomes]
    invalid = sorted(
        {f"{i}={s}" for i, s in outcomes.items() if s not in TERMINAL_STATES}
    )
    return {
        "run_id": run_id,
        "run_dir": run_dir,
        "admitted": admitted,
        "undispatched": undispatched,
        "invalid_outcomes": invalid,
        "clean": not undispatched and not invalid,
    }


def resolve_run_dir(arg):
    if arg:
        return arg if os.path.isfile(os.path.join(arg, "run-ledger.json")) else None
    return latest_run_dir(repo_root())


def main(argv):
    args = argv[1:]
    hook = "--hook" in args
    as_json = "--json" in args
    positional = [a for a in args if not a.startswith("-")]
    run_dir = resolve_run_dir(positional[0] if positional else None)

    if hook:
        # Never disrupt a normal session: silent allow when there's nothing to check.
        if not run_dir:
            return 0
        try:
            result = audit(run_dir)
        except Exception:
            return 0
        if result["undispatched"]:
            reason = (
                "faff runcheck: the latest beep-boop run "
                f"({result['run_id']}) has {len(result['undispatched'])} admitted "
                f"issue(s) with no terminal outcome: {', '.join(result['undispatched'])}. "
                "These were admitted to the build queue but never dispatched — that is a "
                "deferred queue, not a complete run. Dispatch them (or genuinely park them "
                "under a valid category) before stopping."
            )
            print(json.dumps({"decision": "block", "reason": reason}))
        return 0

    if not run_dir:
        sys.stderr.write("runcheck: no .faff/runs/*/run-ledger.json found\n")
        return 2
    try:
        result = audit(run_dir)
    except FileNotFoundError:
        sys.stderr.write(f"runcheck: no run-ledger.json in {run_dir}\n")
        return 2
    except (ValueError, json.JSONDecodeError) as exc:
        sys.stderr.write(f"runcheck: malformed ledger in {run_dir}: {exc}\n")
        return 2

    if as_json:
        print(json.dumps(result, indent=2))
    else:
        print(f"run:       {result['run_id']}")
        print(f"admitted:  {len(result['admitted'])}")
        if result["invalid_outcomes"]:
            print(f"INVALID outcomes: {', '.join(result['invalid_outcomes'])}")
        if result["undispatched"]:
            print(f"UNDISPATCHED ({len(result['undispatched'])}): "
                  f"{', '.join(result['undispatched'])}")
            print("→ run is NOT complete: dispatch these or park them under a valid category.")
        else:
            print("clean: every admitted issue reached a terminal outcome.")

    if result["undispatched"]:
        return 3
    if result["invalid_outcomes"]:
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
