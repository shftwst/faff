#!/usr/bin/env python3
"""validate-adapters — structural conformance lint over faff's shipped slot skills.

The full conformance check (gateway -> Core contracts -> Conformance clause) is a
semantic judgement done by `faffter-dark-authoring-adaptors`' Validate face (an
agent). This script is the *mechanical* complement: a fast, deterministic lint of
the shipped defaults that catches the drift a structural check can see — a dropped
refer-back, a missing "gateway wins" non-normative marker, a methodology that stops
naming a required output, a mechanism occupant that no longer points at its gateway
contract. Suitable for CI / pre-commit. It does NOT replace the agent Validate face
(it cannot judge "maps onto, never redefines" semantically).

Usage:  python3 validate-adapters [--skills-dir DIR]
Exit:   0 all pass · 1 one or more checks failed · 2 a shipped slot skill has no
        registered checks (add one) or the skills dir is missing.
"""
import os
import re
import sys

# Per-skill expectations, keyed by skill dir name. type drives which checks run.
REGISTRY = {
    "faffidavit-spec":      {"type": "adaptor", "slot": "spec_adaptor"},
    "faffidavit-review":    {"type": "adaptor", "slot": "review_adaptor"},
    "faffidavit-routing":   {"type": "adaptor", "slot": "routing_adaptor"},
    "faffidavit-rendering": {"type": "pure-adaptor", "slot": "rendering_adaptor"},
    "faffter-noon-methodology-structural":     {"type": "methodology"},
    "faffter-dark-methodology-agile-delivery": {"type": "methodology"},
    "faffter-noon-concurrency-sequential": {"type": "mechanism"},
    "faffter-dark-concurrency-parallel":   {"type": "mechanism"},
    "faffter-noon-spec":   {"type": "producer-spec"},
    "faffter-dark-nlspec": {"type": "producer-spec"},
    "faffter-noon-intake": {"type": "producer-intake"},
    "faffter-noon-review": {"type": "producer-review"},
    "faffter-dark-adversarial-review": {"type": "producer-review"},
}
# Shipped faffter-*/faffidavit-* skills that are NOT slot occupants (no checks).
SKIP = {"faffter-dark-authoring-adaptors"}

REQUIRED_METHODOLOGY_OUTPUTS = ["backlog-diagnostics", "pick-ordering",
                                "promotion-readiness", "build-queue"]
REFER_BACK = re.compile(r"Read\s+`?~/\.claude/skills/faff/SKILL\.md")
NON_NORMATIVE = re.compile(r"non-normative|gateway wins", re.I)


def checks_for(name, meta, text):
    """Return a list of (ok: bool, label: str)."""
    t = text
    typ = meta["type"]
    out = []

    if typ == "adaptor":
        out.append((bool(REFER_BACK.search(t)),
                    "refer-back to ~/.claude/skills/faff/SKILL.md when standalone"))
        out.append((bool(NON_NORMATIVE.search(t)),
                    "recap marked non-normative / 'gateway wins'"))
        out.append((meta["slot"] in t, f"names its slot ({meta['slot']})"))
        out.append(("no internal contract" not in t.lower(),
                    "an adaptor over a fixed contract must NOT claim 'no internal contract'"))

    elif typ == "pure-adaptor":
        out.append(("no internal contract" in t.lower(),
                    "pure adaptor declares it has no internal contract"))
        out.append((meta["slot"] in t, f"names its slot ({meta['slot']})"))

    elif typ == "methodology":
        for o in REQUIRED_METHODOLOGY_OUTPUTS:
            out.append((o in t, f"answers required output `{o}`"))
        out.append(("methodology` slot" in t or "methodology slot" in t,
                    "references the gateway methodology-slot contract"))

    elif typ == "mechanism":
        out.append(("Mechanism slots" in t or "slot contract" in t,
                    "refers back to the gateway mechanism-slot contract"))
        out.append(("merge gate" in t, "states it never weakens the merge gate"))
        out.append(("ledger" in t, "records terminal outcomes to the run ledger"))

    elif typ == "producer-spec":
        out.append(("spec_adaptor" in t or "spec contract" in t,
                    "maps onto the spec_adaptor contract"))
        out.append(("confidence" in t.lower(), "emits a confidence self-rating"))

    elif typ == "producer-intake":
        out.append(("discovery brief" in t.lower(), "emits a discovery brief"))

    elif typ == "producer-review":
        out.append(("review_adaptor" in t or re.search(r"pass.*fail.*needs-human", t),
                    "maps onto the review-verdict contract (pass/fail/needs-human)"))

    return out


def main(argv):
    skills_dir = "skills"
    if "--skills-dir" in argv:
        skills_dir = argv[argv.index("--skills-dir") + 1]
    else:
        # default: the bundled skills/ dir — this script lives at skills/faff/, so
        # the skills root is its parent. Script-relative so it works from any cwd.
        here = os.path.dirname(os.path.abspath(__file__))
        cand = os.path.abspath(os.path.join(here, ".."))
        skills_dir = cand if os.path.isdir(os.path.join(cand, "faffidavit-spec")) else "skills"

    if not os.path.isdir(skills_dir):
        sys.stderr.write(f"validate-adapters: skills dir not found: {skills_dir}\n")
        return 2

    present = sorted(
        d for d in os.listdir(skills_dir)
        if (d.startswith("faffidavit-") or d.startswith("faffter-"))
        and os.path.isfile(os.path.join(skills_dir, d, "SKILL.md"))
    )

    failed = False
    uncovered = []
    for name in present:
        if name in SKIP:
            continue
        meta = REGISTRY.get(name)
        if not meta:
            uncovered.append(name)
            continue
        text = open(os.path.join(skills_dir, name, "SKILL.md")).read()
        results = checks_for(name, meta, text)
        bad = [label for ok, label in results if not ok]
        if bad:
            failed = True
            print(f"FAIL  {name} ({meta['type']})")
            for label in bad:
                print(f"        ✗ {label}")
        else:
            print(f"pass  {name} ({meta['type']}) — {len(results)} checks")

    # Registered-but-absent (a default got removed/renamed without updating the registry)
    missing = [n for n in REGISTRY if n not in present]
    for n in missing:
        print(f"WARN  {n} is registered but not present on disk")

    if uncovered:
        print()
        for n in uncovered:
            print(f"UNCOVERED  {n} — a shipped slot skill with no registered checks; add it to validate-adapters")
        return 2

    print()
    print("RESULT:", "FAIL" if failed else "PASS",
          f"({len(present) - len(SKIP & set(present))} slot skills linted)")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
