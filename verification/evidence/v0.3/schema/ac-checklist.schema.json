{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/evidence/v0.3/ac-checklist",
  "title": "<anchor-dir>/ac-checklist.json",
  "description": "`criteria` is the one optional key and is omitted only for a zero-AC issue (readAcComplete treats an absent key as schema-1 and rejects [] and null).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "all_verified"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "evidence document version; stamped by the writer"
    },
    "faff_version": {
      "type": "string",
      "description": "faff plugin release version that wrote this document (FAFF-1395); \"unknown\" when unresolved; absent on documents written before FAFF-1395"
    },
    "all_verified": {
      "type": "boolean"
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ac",
          "verified",
          "passed"
        ],
        "properties": {
          "ac": {
            "type": "string"
          },
          "verified": {
            "type": "string",
            "description": "evidence line, or `Needs human verification: <reason>`"
          },
          "passed": {
            "type": "boolean"
          },
          "ac_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z][a-z0-9]{1,15}-[1-9][0-9]*#(ac-[1-9][0-9]*|done:[1-9][0-9]*)$",
            "description": "qualified AC id: lowercase ticket, `#`, then the spec's local id or the positional fallback"
          },
          "verifications": {
            "type": [
              "array",
              "null"
            ],
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "test",
                    "command",
                    "human"
                  ]
                },
                "locator": {
                  "type": "string",
                  "description": "`<file>::<test title>` for test, the exact command for command, absent for human"
                }
              }
            },
            "description": "how the criterion was verified, one entry per method"
          }
        }
      },
      "minItems": 1
    }
  }
}
