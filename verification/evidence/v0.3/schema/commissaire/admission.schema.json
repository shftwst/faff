{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/evidence/v0.3/commissaire/admission",
  "title": "declared-effects.jsonl schema-3 record, kind_of_entry admission",
  "description": "The seq-0 admission Commissaire signs (commissaire.ts cmdAdmit, governor.ts admit). custody is set only by a governor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "seq",
    "ts",
    "author",
    "producer_id",
    "contract_revision",
    "kind_of_entry",
    "step",
    "prev",
    "commissaire_sig",
    "payload"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "ts": {
      "type": "string"
    },
    "author": {
      "type": "string",
      "enum": [
        "commissaire"
      ]
    },
    "producer_id": {
      "type": "string"
    },
    "contract_revision": {
      "type": "string"
    },
    "kind_of_entry": {
      "type": "string",
      "enum": [
        "admission"
      ]
    },
    "step": {
      "type": "string"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "unit_id": {
      "type": "string"
    },
    "issue": {
      "type": "string"
    },
    "commissaire_sig": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_id",
        "contract_revision",
        "admitted_scope",
        "pk_fingerprint",
        "admitted_at"
      ],
      "properties": {
        "producer_id": {
          "type": "string"
        },
        "contract_revision": {
          "type": "string"
        },
        "admitted_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pk_fingerprint": {
          "type": "string"
        },
        "admitted_at": {
          "type": "string"
        },
        "custody": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "governor",
            null
          ]
        }
      }
    }
  }
}
