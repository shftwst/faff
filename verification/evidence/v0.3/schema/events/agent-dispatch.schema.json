{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/evidence/v0.3/events/agent-dispatch",
  "title": "events.jsonl schema-2 record, type agent-dispatch",
  "description": "The dispatch claim for one subagent fan-out. The key set is exactly DISPATCH_ALLOWED_DATA_KEYS (events.js).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "seq",
    "ts",
    "phase",
    "type",
    "prev",
    "data"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "ts": {
      "type": "string"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "run",
        "tidy",
        "prep",
        "build",
        "plot"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "agent-dispatch"
      ]
    },
    "issue": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "dispatch_id",
        "cluster_id",
        "cluster_size"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "producer",
            "build",
            "reader",
            "verify"
          ]
        },
        "dispatch_id": {
          "type": "string"
        },
        "cluster_id": {
          "type": "string"
        },
        "cluster_size": {
          "type": "integer"
        },
        "tokens": {
          "type": [
            "object",
            "null"
          ],
          "description": "null is the estimate form (tokens_source estimate). The legacy cache_write class is accepted on committed lines; eventViolations normalises it before any new write.",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cache_read"
          ],
          "properties": {
            "input": {
              "type": "integer"
            },
            "output": {
              "type": "integer"
            },
            "cache_read": {
              "type": "integer"
            },
            "cache_write_5m": {
              "type": "integer"
            },
            "cache_write_1h": {
              "type": "integer"
            },
            "cache_write": {
              "type": "integer"
            }
          }
        },
        "tokens_source": {
          "type": "string"
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "gate": {
          "type": "string",
          "enum": [
            "structural",
            "adversarial",
            "holdout",
            "ci"
          ]
        },
        "rework_turns": {
          "type": "integer"
        }
      }
    }
  }
}
