{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/evidence/v0.3/events/budget-checkpoint",
  "title": "events.jsonl schema-2 record, type budget-checkpoint",
  "description": "A budget checkpoint: the agent relays the faff budget check BudgetState (budget.js).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "seq",
    "ts",
    "phase",
    "type",
    "prev"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "ts": {
      "type": "string"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "run",
        "tidy",
        "prep",
        "build",
        "plot"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "budget-checkpoint"
      ]
    },
    "issue": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "spent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "elapsed_ms": {
              "type": [
                "integer",
                "null"
              ]
            },
            "attempts": {
              "type": "integer"
            },
            "tokens": {
              "type": "number"
            },
            "cost": {
              "type": [
                "number",
                "null"
              ]
            },
            "until_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "The until deadline the check compared against (FAFF-1444): present only when an until ceiling is set; null when the run-start anchor was unusable and until was treated as reached"
            }
          }
        },
        "tokens_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "breached": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcome": {
          "type": "string"
        },
        "resume_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "indeterminate": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "spend_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string"
              },
              "tokens": {
                "type": "number"
              },
              "records": {
                "type": "integer"
              },
              "engines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "unmetered_engines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "engine": {
                "type": "string"
              },
              "waived": {
                "type": "boolean"
              }
            }
          }
        },
        "at": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "tokens": {
          "type": [
            "object",
            "null"
          ],
          "description": "null is the estimate form (tokens_source estimate). The legacy cache_write class is accepted on committed lines; eventViolations normalises it before any new write.",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cache_read"
          ],
          "properties": {
            "input": {
              "type": "integer"
            },
            "output": {
              "type": "integer"
            },
            "cache_read": {
              "type": "integer"
            },
            "cache_write_5m": {
              "type": "integer"
            },
            "cache_write_1h": {
              "type": "integer"
            },
            "cache_write": {
              "type": "integer"
            }
          }
        },
        "ledger_sha256_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "ledger_sha256_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "gate": {
          "type": "string",
          "enum": [
            "structural",
            "adversarial",
            "holdout",
            "ci"
          ]
        },
        "rework_turns": {
          "type": "integer"
        },
        "dropped_keys": {
          "type": "array",
          "description": "Set only by faff events append: the names of agent data keys outside this schema, sorted.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          }
        },
        "forbidden_side_effect": {
          "type": "boolean",
          "description": "Read by sentry.js evalForbiddenSideEffect on any event: the effects-to-sentry bridge an orchestrator writes on an escape."
        }
      }
    }
  }
}
