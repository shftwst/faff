{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/evidence/v0.3/events/corrective-authored",
  "title": "events.jsonl schema-2 record, type corrective-authored",
  "description": "corrective.js: the written CorrectiveInput record plus the artifact file name.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "seq",
    "ts",
    "phase",
    "type",
    "prev",
    "issue",
    "data"
  ],
  "properties": {
    "schema": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "run_id": {
      "type": "string"
    },
    "seq": {
      "type": "integer"
    },
    "ts": {
      "type": "string"
    },
    "prev": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase": {
      "type": "string",
      "enum": [
        "run",
        "tidy",
        "prep",
        "build",
        "plot"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "corrective-authored"
      ]
    },
    "issue": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "issue": {
          "type": "string"
        },
        "op": {
          "type": "string"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cause": {
              "type": [
                "string",
                "null"
              ]
            },
            "surfaces": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "threshold": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "value": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "subset": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "cites": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "signal": {
              "type": "string"
            },
            "event_seq": {
              "type": [
                "integer",
                "null"
              ]
            },
            "evidence": {
              "type": "string"
            }
          }
        },
        "authored_at": {
          "type": "string"
        },
        "authored_by": {
          "type": "string"
        },
        "artifact": {
          "type": "string"
        },
        "tokens": {
          "type": [
            "object",
            "null"
          ],
          "description": "null is the estimate form (tokens_source estimate). The legacy cache_write class is accepted on committed lines; eventViolations normalises it before any new write.",
          "additionalProperties": false,
          "required": [
            "input",
            "output",
            "cache_read"
          ],
          "properties": {
            "input": {
              "type": "integer"
            },
            "output": {
              "type": "integer"
            },
            "cache_read": {
              "type": "integer"
            },
            "cache_write_5m": {
              "type": "integer"
            },
            "cache_write_1h": {
              "type": "integer"
            },
            "cache_write": {
              "type": "integer"
            }
          }
        },
        "tokens_source": {
          "type": "string"
        },
        "ledger_sha256_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "ledger_sha256_after": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        },
        "gate": {
          "type": "string",
          "enum": [
            "structural",
            "adversarial",
            "holdout",
            "ci"
          ]
        },
        "rework_turns": {
          "type": "integer"
        },
        "dropped_keys": {
          "type": "array",
          "description": "Set only by faff events append: the names of agent data keys outside this schema, sorted.",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          }
        },
        "forbidden_side_effect": {
          "type": "boolean",
          "description": "Read by sentry.js evalForbiddenSideEffect on any event: the effects-to-sentry bridge an orchestrator writes on an escape."
        }
      }
    }
  }
}
