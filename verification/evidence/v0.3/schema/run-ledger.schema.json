{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "faff/evidence/v0.3/run-ledger",
  "title": "<anchor-dir>/run-ledger.json",
  "description": "Closed at every level except outcome_details entries, which are free-form objects (any keys, any JSON values) because no gate reads them. Only schema_version and run_id are required because CLI code and agents following SKILL prose write the ledger and resume logic branches on key presence. Issue-keyed maps use additionalProperties as a schema. Keys come from the CLI writers, the SKILL prose and committed ledgers (see evidence-documents.md).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ],
      "description": "evidence document version; stamped by the shared serialiser"
    },
    "run_id": {
      "type": "string"
    },
    "schema": {
      "type": "integer"
    },
    "level": {
      "type": "string"
    },
    "mode": {
      "type": "string"
    },
    "phase_select": {
      "type": "string"
    },
    "stop_reason": {
      "type": "string"
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "base_sha_required": {
      "type": "boolean"
    },
    "attempts": {
      "type": "integer"
    },
    "discovered_scope_filed": {
      "type": "integer"
    },
    "no_progress_waves": {
      "type": "integer"
    },
    "admitted": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prep_queue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prep_parked": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_adversarial_skipped": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_outage_pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "spec_review_outage_pending": {
      "type": "array",
      "items": {
        "type": "string"
      }
