      }
    },
    "post_merge_verification_unverified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "shipped",
          "pr-open",
          "parked",
          "errored",
          "routed-out",
          "unreached-budget",
          "claimed-by-peer",
          "superseded",
          "parked-window"
