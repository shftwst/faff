  "findings": [
    {
      "kind": "run-status distinction",
      "finding": "Sol high and Terra medium score 136/136 assessed cases but only 5/8 and 0/8 strict native runs pass. They are correctly excluded. Sol low has 7/8 assessed runs and 133/136 assessed cases, so its functional failure is not hidden by full artifact scores."
    },
    {
      "kind": "raw versus assessed",
      "finding": "The screen preserves raw report statuses separately. Known decision answer normalisation raises assessed rendering scores; selection uses explicitly labelled assessed counts. Manual gloss checks still identify omitted memoising explanations even where the artifact rubric passes."
    },
    {
      "kind": "source fidelity versus required explanation",
      "finding": "All combinations preserve reviewed source facts, yet all have two baseline memoising explanations missing; shortened-prompt candidates explain reuse. This bounded limitation is common and disclosed, not a perfect-style claim."
    },
    {
      "kind": "timing confounders",
      "finding": "Only two samples per policy arm and task underpin selection. Concurrent lanes, shared queues and resource variance prevent a causal model speed claim. Astra low remains eligible; its small observed timing gap is not evidence of worse general speed or quality."
    },
    {
      "kind": "Opus comparison",
      "finding": "Opus and GPT differ in guidance and transport. Hard-task GPT wording removes provider-independence claims and uses a preregistered calibration wrapper. No pure model-only, provider independence or general Opus equivalence conclusion is supported."
    },
    {
      "kind": "reuse",
      "finding": "Existing Sol-medium samples 3-5 were completed before selection and are explicitly reused. The new queue adds Astra samples 3-5 and ten challenge samples per finalist rather than replacing screen failures."
    }
