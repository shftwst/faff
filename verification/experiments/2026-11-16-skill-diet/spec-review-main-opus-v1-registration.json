  "runner": "run-literal-workflow-samples.py",
  "samples_per_arm": 1,
  "retries": 0,
  "candidate_gate": "Require baseline strict raw pass, complete native policy/model/guidance pass, independent all-six-artifact and fifteen-decision manual pass, and real contract/routing consumption before launching the candidate. Otherwise hold; no retry.",
  "required_manual_review": [
    "Read all six actual artifact bodies and fifteen actual decisions against the supplied specs, repository context, selected lenses and attached methodology critique.",
    "Objections must be founded, at most one per selected lens, preserve relevant infosec/QA mandatory semantics, and name supported evidence and concrete consequences; builder-settleable choices do not become invented objections.",
    "Verify spec_anchor identity against the raw supplied heading and correct slug; omission only where no single section applies. Do not infer identity from slug shape alone.",
    "Verify severity-to-verdict roll-up, founded non-approve objections, methodology blocker consumption and gap handling, and consistency of objections, verdict and routing signals. Consumer owns prep/plot routing; producer does not relabel it.",
    "Bind artifact/report/capture/native hashes and inspect actual outputs; no raw failure waiver or new lexical/semantic assessment."
  ],
  "required_real_consumption": {
    "consumer": "eval/control-parity/spec-review-artifact.mjs",
    "export": "consumeSpecReviewArtifact",
    "runtime_root": "/Users/shftwst/workspace/shftwst/faff/.worktrees/review-comment-interactive",
    "runtime_commit": "a8509086ad28fa0e55cf3d1d818f2055294e663b",
    "artifacts_per_arm": 6,
    "assertions": [
      "Actual spec-review-verdict contract validation passes.",
      "Actual reject-approach route destination equals the unchanged fixture expected_route; other verdicts have no route.",
      "Actual verdict equals fixture expected_verdict; required_lens present; no duplicate or unselected lenses.",
      "Unfounded contrary verdict mutation is rejected by the existing consumer."
    ],
    "existing_replay_limit": "replay-spec-review-artifacts.mjs is frozen as historical protocol evidence but hardcodes five samples per arm and is not claimed executable against this one-sample plan. Use the existing consumer export for the separate actual-artifact gate without changing measured harness or runner.",
    "exact_invocation": "consumeSpecReviewArtifact(runtime_root, actual artifact UTF-8 text read from workflow-runs/SAMPLE/artifacts/CASE_ID.md, new isolated per-artifact output directory)",
    "expected_results_by_case": [
      {
        "case_id": "spec-verdict-001",
        "verdict": "approve",
        "route_destination": null,
        "required_lens": null
      },
      {
        "case_id": "spec-verdict-002",
        "verdict": "reject-approach",
        "route_destination": "prep",
        "required_lens": "architectural"
      },
      {
        "case_id": "spec-verdict-003",
        "verdict": "needs-human",
        "route_destination": null,
        "required_lens": "infosec"
      },
      {
        "case_id": "qa-repo-file",
        "verdict": "revise",
        "route_destination": null,
        "required_lens": "QA"
      },
      {
        "case_id": "qa-no-observation",
        "verdict": "revise",
        "route_destination": null,
        "required_lens": "QA"
      },
      {
        "case_id": "methodology-blocker",
        "verdict": "reject-approach",
        "route_destination": "plot",
        "required_lens": "methodology"
      }
    ],
    "per_artifact_record": "Persist consumption.json separately for each actual artifact: input artifact path/SHA256, pinned runtime binding, existing consumer source SHA256, complete actual consumer result and rejected unfounded-verdict mutation result. Bind all consumption records into the independent arm review."
  },
