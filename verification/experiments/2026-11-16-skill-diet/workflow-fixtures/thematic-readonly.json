    {
      "id": "termination-policy",
      "output": "run-termination-policy",
      "request": "Return {\"ladder\": [{\"test\": string, \"verdict\": string}, ...]} for the complete thematic policy. The controlled caller will run this supplied ladder against independent CLI signal cases.",
      "input": {},
      "kind": "consumer",
      "oracle": {
        "required": {
          "ladder": [
            {
              "test": "non-convergence",
              "verdict": "escalate"
            },
            {
              "test": "budget-narrow",
              "verdict": "continue"
            },
            {
              "test": "budget-stop",
              "verdict": "run-complete"
            },
            {
              "test": "value-inflection",
              "verdict": "run-complete"
            },
            {
              "test": "work-remaining",
              "verdict": "continue"
            },
            {
              "test": "clean-complete",
              "verdict": "run-complete"
            }
          ]
        }
      },
      "reference": {
        "ladder": [
          {
            "test": "non-convergence",
            "verdict": "escalate"
          },
          {
            "test": "budget-narrow",
            "verdict": "continue"
          },
          {
            "test": "budget-stop",
            "verdict": "run-complete"
          },
          {
            "test": "value-inflection",
            "verdict": "run-complete"
          },
          {
            "test": "work-remaining",
            "verdict": "continue"
          },
          {
            "test": "clean-complete",
            "verdict": "run-complete"
          }
        ]
      },
      "consumer": "run-done",
      "consumer_scenarios": [
        {
          "id": "non-convergence",
          "args": [
            "--non-convergence",
            "--inflection",
            "reached"
          ],
          "expected": {
            "verdict": "escalate",
            "reason": "non-convergence",
            "conformant": true
          }
        },
        {
          "id": "narrow-before-inflection",
          "args": [
            "--budget",
            "{\"breached\": [\"tokens\"], \"outcome\": \"narrow\"}",
            "--inflection",
            "reached"
          ],
          "expected": {
            "verdict": "continue",
            "reason": "budget-narrow(tokens)",
            "conformant": true
          }
        },
        {
          "id": "budget-stop",
          "args": [
            "--budget",
            "{\"breached\": [\"tokens\"], \"outcome\": \"stop\"}"
          ],
          "expected": {
            "verdict": "run-complete",
            "reason": "budget-hit(tokens)",
            "conformant": true
          }
        },
        {
          "id": "inflection",
          "args": [
            "--inflection",
            "reached"
          ],
          "expected": {
            "verdict": "run-complete",
            "reason": "value-inflection",
            "conformant": true
          }
        },
        {
          "id": "work-remaining",
          "args": [],
          "expected": {
            "verdict": "continue",
            "reason": "work-remaining",
            "conformant": true
          }
        },
        {
          "id": "drained",
          "args": [
            "--queue-empty",
            "--ledger-clean"
          ],
          "expected": {
            "verdict": "run-complete",
            "reason": "drained",
            "conformant": true
          }
        },
        {
          "id": "budget-floor",
          "args": [
            "--budget",
            "{\"breached\": [\"tokens\"], \"outcome\": \"escalate\"}",
            "--non-convergence"
          ],
          "expected": {
            "verdict": "escalate",
            "reason": "budget-escalated(tokens)",
            "conformant": true
          }
        },
        {
          "id": "ledger-floor",
          "args": [
            "--queue-empty",
            "--no-ledger-clean"
          ],
          "expected": {
            "verdict": "continue",
            "reason": "undispatched-ledger",
            "conformant": true
          }
        },
        {
          "id": "product-floor",
          "args": [
            "--queue-empty",
            "--ledger-clean",
            "--prd-coverage",
            "{\"satisfied\": false}"
          ],
          "expected": {
            "verdict": "escalate",
            "reason": "product-incomplete",
            "conformant": true
          }
        }
      ]
    }
