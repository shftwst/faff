    {
      "seq": 1,
      "name": "submit_output",
      "args": {
        "case_id": "activity-name",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 1,
              "diagnosis": "W1, 'Q2 sprint 3', names a time bucket although its stated outcome is reducing checkout abandonment and A preserves the checkout address on validation error. The name hides the shared outcome needed to assess sequencing.",
              "recommended_action": "Consider renaming W1 to 'Reduce checkout abandonment' so its name states the outcome A supports."
            }
          ]
        }
      },
      "case_id": "activity-name",
      "result": {
        "persisted": true,
        "sha256": "589f811ac6b4e92ae9117dbfbd8d93e7eb2e3dcfe0f7e807b585cec33238e3fb",
        "consumer_calls": 0
      }
    },
    {
      "seq": 2,
      "name": "submit_output",
      "args": {
        "case_id": "human-wip",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 3,
              "diagnosis": "Alex is actively building A, B, C and D: human WIP is 4, above the cap of 3. Pulling proposed item I would add context switching and delay finishing existing work. Autonomous items E, F and G and review-queued H do not count towards this cap.",
              "recommended_action": "Finish existing human work to return to the cap; defer I until human WIP is below 3 before pulling it."
            }
          ]
        }
      },
      "case_id": "human-wip",
      "result": {
        "persisted": true,
        "sha256": "ec3e677deed331fe1a54662d2e7ef0364c8816015111961fa90ada75acf45687",
        "consumer_calls": 0
      }
    },
    {
      "seq": 3,
      "name": "submit_output",
      "args": {
        "case_id": "right-size",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 4,
              "diagnosis": "BIG, 'Improve account access', is estimated at 6 days and combines a 3-day session-token verifier with an independent 3-day account-recovery UI. Bundling independently shippable concerns hides progress and makes one wait for the other.",
              "recommended_action": "Consider splitting BIG into two 3-day tickets, one for the verifier and one for the recovery UI, so each can ship independently."
            }
          ]
        }
      },
      "case_id": "right-size",
      "result": {
        "persisted": true,
        "sha256": "4a3a4739ef132cbb6de1b33486bb39e292bd5f5874e8c9da8cae38111c583a69",
        "consumer_calls": 0
      }
    },
    {
      "seq": 4,
      "name": "submit_output",
      "args": {
        "case_id": "cohesion",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 5,
              "diagnosis": "W2, 'Faster onboarding', combines ON, shortening signup to one screen for faster onboarding, with BILL, producing monthly invoices for billing accuracy. These are distinct outcomes with different completion criteria, so a single workstream obscures sequencing and what done means.",
              "recommended_action": "Consider keeping ON in Faster onboarding and moving BILL to an outcome-led Billing accuracy workstream, subject to human agreement."
            }
          ]
        }
      },
      "case_id": "cohesion",
      "result": {
        "persisted": true,
        "sha256": "70b245f0b4ba2cb7cacb3e3ef7adbe21cf7d18240b7318ee536f06d36169160a",
        "consumer_calls": 0
      }
    },
    {
      "seq": 5,
      "name": "submit_output",
      "args": {
        "case_id": "implicit-dependency",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 6,
              "diagnosis": "CLIENT, the client enablement work, requires the schema emitted by SCHEMA, 'Publish the schema', but CLIENT has no blocked_by links and SCHEMA remains in Backlog. CLIENT can therefore appear ready before its required schema exists.",
              "recommended_action": "If this dependency is real, declare SCHEMA as a blocker of CLIENT; if it is not, remove the dependency reference from CLIENT's spec."
            }
          ]
        }
      },
      "case_id": "implicit-dependency",
      "result": {
        "persisted": true,
        "sha256": "b7f5de3bde147e01e10d290356348bbd8f65d37eb9aa13fb665057b6d4809305",
