    {
      "seq": 6,
      "name": "submit_output",
      "args": {
        "case_id": "late-risk",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 7,
              "diagnosis": "PAY, 'Accept card payments', places BANK, the unfamiliar bank API integration, after UI and COPY. BANK depends on an external team, is unproven and has no spike; integration surprises would arrive after the earlier work, leaving less time to change course.",
              "recommended_action": "Consider moving BANK earlier or proposing a small de-risking spike before committing to the full integration and dependent delivery plan."
            }
          ]
        }
