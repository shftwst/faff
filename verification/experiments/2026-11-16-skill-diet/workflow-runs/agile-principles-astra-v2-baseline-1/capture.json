    {
      "seq": 1,
      "name": "submit_output",
      "args": {
        "case_id": "activity-name",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 1,
              "diagnosis": "W1, 'Q2 sprint 3', is named for a sprint despite its stated outcome of reducing checkout abandonment. A, keeping the checkout address on validation error, serves that outcome; the sprint name hides the shared delivery goal and makes sequencing harder to interpret.",
              "recommended_action": "Rename W1 to 'Reduce checkout abandonment' so its name states the outcome its work serves."
            }
          ]
        }
      },
      "case_id": "activity-name",
      "result": {
        "persisted": true,
        "sha256": "1a5c2906fe81ab5526ff4dff23236b961d64bd9aeda4264cc856150e2fc7f5cd",
        "consumer_calls": 0
      }
    },
    {
      "seq": 2,
      "name": "submit_output",
      "args": {
        "case_id": "human-wip",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 3,
              "diagnosis": "Alex is actively building A, B, C and D: human WIP is 4 against a cap of 3. Pulling proposed item I would increase context switching and delay completion. Autonomous items E, F and G and H awaiting human review do not count towards this cap.",
              "recommended_action": "Finish an active item to return to the cap, and bring human WIP below 3 before pulling I."
            }
          ]
        }
      },
      "case_id": "human-wip",
      "result": {
        "persisted": true,
        "sha256": "5ef86f5681091ecb137eeb28c9784953f66b5804d25cab223af9d23377feb486",
        "consumer_calls": 0
      }
    },
    {
      "seq": 3,
      "name": "submit_output",
      "args": {
        "case_id": "right-size",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 4,
              "diagnosis": "BIG, 'Improve account access', estimates six days and combines a three-day session-token verifier with an independent three-day account-recovery UI. Either can ship alone, so bundling them hides separate progress and delays one deliverable behind the other.",
              "recommended_action": "Split BIG into a session-token verifier ticket and an account-recovery UI ticket, each estimated at three days, preserving the parent and allowing independent delivery."
            }
          ]
        }
      },
      "case_id": "right-size",
      "result": {
        "persisted": true,
        "sha256": "3caee443180d7747689404c0ceffaa2732781f925063ba462fb38c6f9957c303",
        "consumer_calls": 0
      }
    },
    {
      "seq": 4,
      "name": "submit_output",
      "args": {
        "case_id": "cohesion",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 5,
              "diagnosis": "W2, 'Faster onboarding', combines ON, shortening signup to one screen for faster onboarding, with BILL, producing monthly invoices for billing accuracy. The two outcomes need different sequencing and completion criteria, so W2 no longer describes one coherent deliverable.",
              "recommended_action": "Keep ON under Faster onboarding and propose an outcome-led Billing accuracy home for BILL, with separate completion criteria."
            }
          ]
        }
      },
      "case_id": "cohesion",
      "result": {
        "persisted": true,
        "sha256": "21cbd9ad4e2e34aa6049717020e4416fcd666f0d7251671cf11b07e1062c716b",
        "consumer_calls": 0
      }
    },
    {
      "seq": 5,
      "name": "submit_output",
      "args": {
        "case_id": "implicit-dependency",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 6,
              "diagnosis": "CLIENT, enabling the schema-consuming client, explicitly needs output from SCHEMA, publishing the schema, but CLIENT has no declared blockers and SCHEMA remains in Backlog. The graph can therefore present CLIENT as ready before its required schema exists.",
              "recommended_action": "Declare SCHEMA as a blocker of CLIENT if this dependency is real; otherwise remove the dependency reference from CLIENT's spec."
            }
          ]
        }
      },
      "case_id": "implicit-dependency",
      "result": {
        "persisted": true,
        "sha256": "aed90824369152b056d9c087d8fb0296688d91568961affaf9d4a106aa926b9a",
        "consumer_calls": 0
      }
    },
    {
      "seq": 6,
      "name": "submit_output",
      "args": {
        "case_id": "late-risk",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 7,
              "diagnosis": "PAY, 'Accept card payments', schedules BANK, integrating an unfamiliar bank API, after UI and COPY. BANK depends on an external team, the integration is unproven and no spike exists. Discovering integration constraints last risks rework and delayed payment delivery after the preceding work is complete.",
              "recommended_action": "Propose pulling BANK forward or running a small integration spike before committing to the full BANK scope and the dependent delivery plan."
            }
          ]
        }
      },
