    {
      "seq": 1,
      "name": "submit_output",
      "args": {
        "case_id": "activity-name",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 1,
              "diagnosis": "W1, 'Q2 sprint 3', is named for a sprint even though its stated outcome is reducing checkout abandonment and A preserves the checkout address on validation error. The name hides that outcome, making the workstream's purpose and sequencing harder to assess.",
              "recommended_action": "Rename W1 to 'Reduce checkout abandonment' to expose the outcome already shared by its work."
            }
          ]
        }
      },
      "case_id": "activity-name",
      "result": {
        "persisted": true,
        "sha256": "d9eb25150f9b372e618fe24e275b57d7992857fa90dd9d0412aa6be42f65e61a",
        "consumer_calls": 0
      }
    },
    {
      "seq": 2,
      "name": "submit_output",
      "args": {
        "case_id": "human-wip",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 3,
              "diagnosis": "Alex is actively building A, B, C and D: four human in-flight issues exceed the cap of three. Pulling proposed next item I would increase context switching and delay finishing current work. Autonomous items E, F and G and H awaiting human review do not count towards this cap.",
              "recommended_action": "Finish current work before pulling I; reduce human in-flight work below three before recommending another pull."
            }
          ]
        }
      },
      "case_id": "human-wip",
      "result": {
        "persisted": true,
        "sha256": "c989de9369a370e0bc3688fbe5499e76fc2341c82de18499fcfb6da9db069322",
        "consumer_calls": 0
      }
    },
    {
      "seq": 3,
      "name": "submit_output",
      "args": {
        "case_id": "right-size",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 4,
              "diagnosis": "BIG, 'Improve account access', combines a three-day session-token verifier and an independent three-day account-recovery UI into six days. Either can ship alone; combining them hides progress and delays delivery of the first completed concern.",
              "recommended_action": "Split BIG into two three-day tickets, one for the session-token verifier and one for the account-recovery UI, so each can ship independently."
            }
          ]
        }
      },
      "case_id": "right-size",
      "result": {
        "persisted": true,
        "sha256": "cd2e66616883291d912f571dcc51dafcbe57dbfa174c487864246a9386ff5d9c",
        "consumer_calls": 0
      }
    },
    {
      "seq": 4,
      "name": "submit_output",
      "args": {
        "case_id": "cohesion",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 5,
              "diagnosis": "W2, 'Faster onboarding', combines ON, shortening signup to one screen, with BILL, producing monthly invoices for billing accuracy. These are distinct outcomes with different sequencing and completion criteria, so completing W2 does not describe one coherent result.",
              "recommended_action": "Keep ON under Faster onboarding and propose a separate Billing accuracy outcome home for BILL, preserving both pieces of work."
            }
          ]
        }
      },
      "case_id": "cohesion",
      "result": {
