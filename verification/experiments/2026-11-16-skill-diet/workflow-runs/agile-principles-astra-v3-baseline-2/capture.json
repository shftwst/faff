    {
      "seq": 1,
      "name": "submit_output",
      "args": {
        "case_id": "activity-name",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 1,
              "diagnosis": "W1, 'Q2 sprint 3', is named for a sprint although its stated outcome is reducing checkout abandonment and A preserves the checkout address on validation error. The name hides the outcome used to sequence the work and assess completion.",
              "recommended_action": "Rename W1 to 'Reduce checkout abandonment' so its name states the supplied outcome."
            }
          ]
        }
      },
      "case_id": "activity-name",
      "result": {
        "persisted": true,
        "sha256": "72a3dc2d8c6aa16999d198572b535a762452889c6b91e985e67d4d1071ae88de",
        "consumer_calls": 0
      }
    },
    {
      "seq": 2,
      "name": "submit_output",
      "args": {
        "case_id": "human-wip",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 3,
              "diagnosis": "Alex is actively building A, B, C and D: human WIP is 4 against a cap of 3. Pulling proposed item I would raise it to 5 and add context switching before current work ships. Autonomous items E, F and G and H awaiting human review do not count towards this cap.",
              "recommended_action": "Defer I and finish existing human work. Pull I only once human WIP is below 3; from 4, two current items must finish before another pull."
            }
          ]
        }
      },
      "case_id": "human-wip",
      "result": {
        "persisted": true,
        "sha256": "36e7aafa7e725a0c1e0a87de6012d32c491bb4e62818585a2c0e45ad3f887fba",
        "consumer_calls": 0
      }
    },
    {
      "seq": 3,
      "name": "submit_output",
      "args": {
        "case_id": "right-size",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 4,
              "diagnosis": "BIG, 'Improve account access', is estimated at 6 days and combines a three-day session-token verifier with an independent three-day account-recovery UI. Keeping them together exceeds the 1-3 day target and delays shipping either concern until both are complete.",
              "recommended_action": "Propose two independently shippable tickets: the session-token verifier and the account-recovery UI, each estimated at three days."
            }
          ]
        }
      },
      "case_id": "right-size",
      "result": {
        "persisted": true,
        "sha256": "8c1115715c7ce72a9a6ea6ae6ecbccba424ba6b9bb58029f0c77dc4160d69048",
        "consumer_calls": 0
      }
    },
    {
      "seq": 4,
      "name": "submit_output",
      "args": {
        "case_id": "cohesion",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 5,
              "diagnosis": "W2, 'Faster onboarding', combines ON, shortening signup to one screen, with BILL, producing monthly invoices for billing accuracy. These are different outcomes with different completion criteria, so one workstream cannot express a single done condition or coherent sequence for both.",
              "recommended_action": "Keep ON under Faster onboarding and propose an outcome-led Billing accuracy home for BILL, preserving both tickets."
            }
          ]
        }
      },
      "case_id": "cohesion",
      "result": {
        "persisted": true,
        "sha256": "fe18e94156f07c4bd4bff653966cac55cdf3b6143e4a2f183ea375464892559d",
        "consumer_calls": 0
      }
    },
    {
      "seq": 5,
      "name": "submit_output",
      "args": {
        "case_id": "implicit-dependency",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 6,
              "diagnosis": "CLIENT requires the schema emitted by SCHEMA, 'Publish the schema', before enabling the client, but CLIENT has no declared blocker and SCHEMA remains in Backlog. The graph can therefore present CLIENT as ready before its required schema exists.",
              "recommended_action": "Recommend declaring SCHEMA as a blocker of CLIENT if the dependency is real; otherwise remove the dependency reference from CLIENT's spec."
            }
          ]
        }
      },
      "case_id": "implicit-dependency",
      "result": {
        "persisted": true,
        "sha256": "3b129cf4540633b057ecbeae13b2d6585c810715d73107bd4e8a0fabbdd2286c",
        "consumer_calls": 0
      }
    },
    {
      "seq": 6,
      "name": "submit_output",
      "args": {
        "case_id": "late-risk",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 7,
              "diagnosis": "PAY, 'Accept card payments', places BANK, the unfamiliar bank API integration involving an external team, last after UI and COPY. No de-risking spike exists. Integration constraints would therefore be discovered after earlier work, leaving less time to adjust the payment plan.",
              "recommended_action": "Propose moving BANK earlier or adding a small bank API feasibility spike before committing to the full integration scope, respecting human-curated sequencing."
            }
          ]
        }
      },
