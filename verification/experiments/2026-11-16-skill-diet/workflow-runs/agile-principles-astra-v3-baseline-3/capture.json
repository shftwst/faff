    {
      "seq": 1,
      "name": "submit_output",
      "args": {
        "case_id": "activity-name",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 1,
              "diagnosis": "W1, 'Q2 sprint 3', is named for a sprint although its stated outcome is reducing checkout abandonment and A preserves the checkout address on validation error. The name hides that outcome, making the workstream's purpose and sequencing harder to assess.",
              "recommended_action": "Rename W1 to 'Reduce checkout abandonment' so its name states the outcome served by A."
            }
          ]
        }
      },
      "case_id": "activity-name",
      "result": {
        "persisted": true,
        "sha256": "94ee6481100b4b45654e8ed134e63b7ce27a7be13719e573c52a492b722e0050",
        "consumer_calls": 0
      }
    },
    {
      "seq": 2,
      "name": "submit_output",
      "args": {
        "case_id": "human-wip",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 3,
              "diagnosis": "Alex is actively building A, B, C and D: human WIP is 4 against a cap of 3. Pulling proposed item I would raise it to 5 and add context-switching before existing work ships. Autonomous items E, F and G and review item H do not count towards human in-flight WIP.",
              "recommended_action": "Finish existing in-flight work before pulling I. Bring human WIP below 3 before starting another item."
            }
          ]
        }
      },
      "case_id": "human-wip",
      "result": {
        "persisted": true,
        "sha256": "732b619d308c544e62e6c660a3e4a9374daf15bbad8a45f724582b186ae56a36",
        "consumer_calls": 0
      }
    },
    {
      "seq": 3,
      "name": "submit_output",
      "args": {
        "case_id": "right-size",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 4,
              "diagnosis": "BIG, 'Improve account access', combines a three-day session-token verifier and an independent three-day account-recovery UI into six days of work. Either can ship alone; bundling them delays independent delivery and hides progress beyond the 1-3 day target.",
              "recommended_action": "Split BIG into two three-day tickets, one for the session-token verifier and one for the account-recovery UI, so either can ship independently."
            }
          ]
        }
      },
      "case_id": "right-size",
      "result": {
        "persisted": true,
        "sha256": "166dde142d02285cda452d76c98ec359ffbb0e447f179f56d451cfc1e34e8aea",
        "consumer_calls": 0
      }
    },
    {
      "seq": 4,
      "name": "submit_output",
      "args": {
        "case_id": "cohesion",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 5,
              "diagnosis": "W2, 'Faster onboarding', contains ON, shortening signup to one screen, and BILL, producing monthly invoices for billing accuracy. These serve distinct outcomes with different completion criteria, so one workstream cannot express a single delivery sequence or definition of done.",
              "recommended_action": "Keep ON under 'Faster onboarding' and propose a separate outcome-led home for BILL under 'Billing accuracy'."
            }
          ]
        }
      },
      "case_id": "cohesion",
      "result": {
        "persisted": true,
        "sha256": "7df941bba9cb547fca2f00d614c6642bf2693e7a283c57de241570b05167cfea",
        "consumer_calls": 0
      }
    },
    {
      "seq": 5,
      "name": "submit_output",
      "args": {
        "case_id": "implicit-dependency",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 6,
              "diagnosis": "CLIENT requires the schema emitted by SCHEMA, 'Publish the schema', before enabling the client, but CLIENT has no declared blockers and SCHEMA remains in Backlog. CLIENT can therefore appear ready before its required schema exists.",
              "recommended_action": "Declare SCHEMA as a blocker of CLIENT if the dependency is real; otherwise remove the schema prerequisite from CLIENT's spec."
            }
          ]
        }
      },
      "case_id": "implicit-dependency",
      "result": {
        "persisted": true,
        "sha256": "8f95eed8b73e1a4842e66273d603e95952ebc6f42855473e84b0e736df2d9196",
        "consumer_calls": 0
      }
    },
    {
      "seq": 6,
      "name": "submit_output",
      "args": {
        "case_id": "late-risk",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 7,
              "diagnosis": "PAY, 'Accept card payments', sequences BANK, an unfamiliar bank API integration involving an external team, after UI and COPY. No spike exists. Integration surprises would arrive after the earlier work, leaving less time to adjust the payment approach and delaying usable card payments.",
              "recommended_action": "Propose moving BANK earlier or adding a small de-risking spike before committing to the full integration and dependent UI work."
            }
          ]
        }
      },
