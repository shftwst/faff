    {
      "seq": 1,
      "name": "submit_output",
      "args": {
        "case_id": "activity-name",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 1,
              "diagnosis": "W1, 'Q2 sprint 3', is named for a sprint although its stated outcome is reducing checkout abandonment and A preserves the checkout address after validation errors. The name hides that outcome, making outcome-based sequencing harder to see.",
              "recommended_action": "Rename W1 to 'Reduce checkout abandonment' so its name expresses the outcome served by A."
            }
          ]
        }
      },
      "case_id": "activity-name",
      "result": {
        "persisted": true,
        "sha256": "95fc8c9bd0796f5fdb25767263082378e5d3c2c97d92a01d7f6e8828d2607a24",
        "consumer_calls": 0
      }
    },
    {
      "seq": 2,
      "name": "submit_output",
      "args": {
        "case_id": "human-wip",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 3,
              "diagnosis": "Alex is actively building A, B, C and D: human WIP is 4 against a cap of 3. Pulling proposed item I would increase context-switching and delay finishing existing work. Autonomous items E, F and G and review-queued H do not count towards this cap.",
              "recommended_action": "Finish existing in-flight work before pulling I; reduce human WIP below 3 before starting another item."
            }
          ]
        }
      },
      "case_id": "human-wip",
      "result": {
        "persisted": true,
        "sha256": "89f9fbb2e0a48cce6f0caf44e497b131ecdaefcf41819b570e455449b5276b09",
        "consumer_calls": 0
      }
    },
    {
      "seq": 3,
      "name": "submit_output",
      "args": {
        "case_id": "right-size",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 4,
              "diagnosis": "BIG, 'Improve account access', combines a three-day session-token verifier with an independent three-day account-recovery UI. Its six-day scope exceeds the 1-3 day target and makes one shippable concern wait for the other.",
              "recommended_action": "Split BIG into two independently shippable three-day tickets, one for the verifier and one for the recovery UI."
            }
          ]
        }
      },
      "case_id": "right-size",
      "result": {
        "persisted": true,
        "sha256": "16426139d818285fe2017d227512a86eb9f833afdbdfa6633bf46e4425140b51",
        "consumer_calls": 0
      }
    },
    {
      "seq": 4,
      "name": "submit_output",
      "args": {
        "case_id": "cohesion",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 5,
              "diagnosis": "W2, 'Faster onboarding', contains ON, shortening signup to one screen, and BILL, producing monthly invoices for billing accuracy. These serve distinct outcomes with different completion criteria, so one workstream cannot express a single delivery outcome for both.",
              "recommended_action": "Keep ON in Faster onboarding and propose a separate billing-accuracy home for BILL, with its own completion criteria."
            }
          ]
        }
      },
      "case_id": "cohesion",
      "result": {
        "persisted": true,
        "sha256": "e109229dd5f437378ba01cf072880c339b813c3189631e166f3616e89f8aec0a",
        "consumer_calls": 0
      }
    },
    {
      "seq": 5,
      "name": "submit_output",
      "args": {
        "case_id": "implicit-dependency",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 6,
              "diagnosis": "CLIENT's spec requires consuming the schema from SCHEMA, 'Publish the schema', before enabling the client, but CLIENT has no declared blocker and SCHEMA is still in Backlog. The graph can therefore present CLIENT as ready before its required schema exists.",
              "recommended_action": "Declare SCHEMA as blocking CLIENT if the dependency is real; otherwise remove the dependency reference from CLIENT's spec."
            }
          ]
        }
      },
      "case_id": "implicit-dependency",
      "result": {
        "persisted": true,
        "sha256": "66d456ee5e945fb680ef258efe4f4021c09464f7fd1ce51c7d5d582b08ec6528",
        "consumer_calls": 0
      }
    },
    {
      "seq": 6,
      "name": "submit_output",
      "args": {
        "case_id": "late-risk",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 7,
              "diagnosis": "PAY, 'Accept card payments', schedules BANK, the unfamiliar bank API integration, after UI and COPY. BANK depends on an external team and has no de-risking spike, so integration failures would be discovered only after the preceding work, delaying payment delivery and leaving little time to change approach.",
              "recommended_action": "Propose moving BANK earlier or scheduling a small integration spike before committing to the full sequence, while respecting human-set ordering."
            }
          ]
        }
      },
      "case_id": "late-risk",
