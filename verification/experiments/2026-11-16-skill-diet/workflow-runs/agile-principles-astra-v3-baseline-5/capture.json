    {
      "seq": 1,
      "name": "submit_output",
      "args": {
        "case_id": "activity-name",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 1,
              "diagnosis": "W1, 'Q2 sprint 3', names a time period despite its stated outcome of reducing checkout abandonment. Its name hides the outcome served by A, keeping the checkout address on validation error, making outcome-based prioritisation harder.",
              "recommended_action": "Rename W1 to 'Reduce checkout abandonment' so its existing outcome is visible."
            }
          ]
        }
      },
      "case_id": "activity-name",
      "result": {
        "persisted": true,
        "sha256": "70802dd7bef964ce8d90c2510248fa505d6ba19077e077f796e7a257fb85b94c",
        "consumer_calls": 0
      }
    },
    {
      "seq": 2,
      "name": "submit_output",
      "args": {
        "case_id": "human-wip",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 3,
              "diagnosis": "Alex is actively building A, B, C and D: human WIP is 4 against a cap of 3. Pulling proposed item I would increase context-switching and delay completion. Autonomous items E, F and G and review-waiting item H do not count towards this cap.",
              "recommended_action": "Finish existing work before pulling I; reduce active work below 3 before adding another item."
            }
          ]
        }
      },
      "case_id": "human-wip",
      "result": {
        "persisted": true,
        "sha256": "32e6085b2ab118ae53c5a7c93f869dc75c8532128c03aaf33c52b0e6e2f4ddd6",
        "consumer_calls": 0
      }
    },
    {
      "seq": 3,
      "name": "submit_output",
      "args": {
        "case_id": "right-size",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 4,
              "diagnosis": "BIG, 'Improve account access', combines a three-day session-token verifier and an independent three-day account-recovery UI. The six-day ticket exceeds the 1-3 day target and ties together work that can ship independently, hiding progress and delaying separate delivery.",
              "recommended_action": "Split BIG into two three-day tickets, one for the verifier and one for the recovery UI, each with its own deliverable."
            }
          ]
        }
      },
      "case_id": "right-size",
      "result": {
        "persisted": true,
        "sha256": "5d2d80704dd73fdce4f8b1d30a87c176b8f00985b51c2dc1c5c33477aaac0e7c",
        "consumer_calls": 0
      }
    },
    {
      "seq": 4,
      "name": "submit_output",
      "args": {
        "case_id": "cohesion",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 5,
              "diagnosis": "W2, 'Faster onboarding', contains ON, shortening signup to one screen, and BILL, producing monthly invoices for billing accuracy. These serve distinct outcomes with different completion criteria, so one workstream cannot express a coherent delivery order or done condition.",
              "recommended_action": "Keep ON in Faster onboarding and propose an outcome-led Billing accuracy home for BILL."
            }
          ]
        }
      },
      "case_id": "cohesion",
      "result": {
        "persisted": true,
        "sha256": "b182a5a8f547e4eb0521d1454de70ab1c3f2c87b68b92f8f1f74598088e9b1f9",
        "consumer_calls": 0
      }
    },
    {
      "seq": 5,
      "name": "submit_output",
      "args": {
        "case_id": "implicit-dependency",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 6,
              "diagnosis": "CLIENT requires the schema emitted by SCHEMA, 'Publish the schema', before enabling the client, but CLIENT has no declared blocker and SCHEMA remains in Backlog. The graph can therefore present CLIENT as ready before its required input exists.",
              "recommended_action": "Declare SCHEMA as a blocker of CLIENT if the dependency is real; otherwise remove the schema prerequisite from CLIENT's spec."
            }
          ]
        }
      },
      "case_id": "implicit-dependency",
      "result": {
        "persisted": true,
        "sha256": "15163f3b1a3190f0fe809a1de959a3ccb6fbcfade402b926208aec4241f09e10",
        "consumer_calls": 0
      }
    },
    {
      "seq": 6,
      "name": "submit_output",
      "args": {
        "case_id": "late-risk",
        "value": {
          "banner": "Methodology: faffter-dark-methodology-agile-delivery",
          "findings": [
            {
              "principle": 7,
              "diagnosis": "PAY, 'Accept card payments', places BANK, the unfamiliar bank API integration, after UI and COPY. BANK depends on an external team and has no de-risking spike, so integration problems would emerge after the earlier work and leave less time to adjust the payment plan.",
              "recommended_action": "Propose moving BANK earlier or placing a small integration spike before UI and COPY to test the external dependency before committing to the full integration."
            }
          ]
        }
      },
