    {
      "name": "read_policy",
      "description": "Read the unchanged policy in bounded chunks. Start at offset 0, then use each returned next_offset until it is null. Complete policy delivery is required before workflow operations. No scratch file is needed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "offset"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "write_output",
      "description": "Persist the completed rendering for one artifact case. Write once per case; provide the actual normalised text or violation report requested.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "answer_rule",
      "description": "Answer one separate bounded policy question in its stated value shape. Do not perform hypothetical actions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string"
          },
          "value": {}
        },
        "required": [
          "case_id",
          "value"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "finish",
      "description": "Finish after all artifacts and rule answers are recorded.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    }
