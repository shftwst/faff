  "rule_questions": [
    {
      "id": "ordering",
      "question": "Who owns ordering inside horizons: \"map\" or \"methodology\"? Return one string."
    },
    {
      "id": "horizon-preserve",
      "question": "Does methodology re-sequencing move items to a different horizon? Return a boolean."
    },
    {
      "id": "cycle-floor",
      "question": "Does absence of a tidy log permit skipping cycle/ghost diagnostics? Return a boolean."
    },
    {
      "id": "off-chain-cycle",
      "question": "Must a cycle entirely off the rendered chain still appear as a risk? Return a boolean."
    },
    {
      "id": "satisfied-edge",
      "question": "Does a blocker edge to shipped work count against fireability? Return a boolean."
    },
    {
      "id": "future-time",
      "question": "May map invent weeks-until-completion estimates beyond named horizons? Return a boolean."
    },
    {
      "id": "project-count",
      "question": "Is three projects per initiative a hard cap that must be enforced? Return a boolean."
    },
    {
      "id": "cross-initiative",
      "question": "Should a cross-initiative blocker also be reported as a same-value-stream cross-project risk? Return a boolean."
    },
    {
      "id": "later-collapse",
      "question": "Is a single collapsed Later project automatically a defect despite an explicit intentional rationale? Return a boolean."
    },
    {
      "id": "status-write",
      "question": "May map itself change tracker project status after finding staleness? Return a boolean."
    },
    {
      "id": "no-risk",
      "question": "If no risks exist, should TL;DR explicitly say none surfaced? Return a boolean."
    },
    {
      "id": "fresh-scope",
      "question": "If fetching the whole roadmap exceeds budget, should map use a complete single-initiative snapshot rather than mixed freshness? Return a boolean."
    }
  ]
}
